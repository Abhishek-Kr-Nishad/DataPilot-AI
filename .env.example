# =============================================================================
# DataPilot AI - Environment Configuration Template
# Copy to .env for local overrides. Never commit real credentials or .env!
# =============================================================================

# Execution Mode: "local" (default) or "aws"
# Local mode runs PySpark and stores Medallion layers on the local filesystem.
# AWS mode requires valid AWS credentials (via IAM role, profile, or env vars)
# and an existing S3 bucket.
DATAPILOT_EXECUTION_MODE=local

# Local Storage, API & Spark Settings
DATAPILOT_DATA_DIR=data
DATAPILOT_LOG_LEVEL=INFO
DATAPILOT_SPARK_MASTER=local[2]
DATAPILOT_SPARK_APP_NAME=DataPilotAI
DATAPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional on Windows when winutils.exe is installed (e.g., C:\Winutils)
DATAPILOT_HADOOP_HOME=

# Data Quality Thresholds
DATAPILOT_MAX_NULL_RATE=0.05
DATAPILOT_MAX_DUPLICATE_RATE=0.05
DATAPILOT_MAX_QUARANTINE_RATE=0.15
DATAPILOT_MIN_ROW_COUNT=1

# Database / Metadata Persistence ("sqlalchemy" default uses local SQLite; "postgres" uses POSTGRES_DSN)
DATAPILOT_METADATA_BACKEND=sqlalchemy
POSTGRES_DSN=
DATABASE_URL=

# AWS Deployment Configuration (leave blank for local development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_S3_BUCKET=
AWS_S3_PREFIX=datapilot-ai
AWS_GLUE_JOB_NAME=datapilot-ecommerce-etl
AWS_GLUE_DATABASE=datapilot_ecommerce_db
AWS_ATHENA_OUTPUT_LOCATION=

# Google Gemini Agent Configuration (mock/deterministic mode works automatically when unset)
GEMINI_API_KEY=
DATAPILOT_GEMINI_MODEL=gemini-2.5-flash
DATAPILOT_AGENT_MODE=auto
